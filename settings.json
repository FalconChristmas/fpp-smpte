{
    "settingGroups": {
        "SMPTETimeCodeInput": {
            "description": "SMPTE TimeCode Support",
            "settings": [
                "SMPTETimeCodeEnabled",
                "SMPTEOutputPipeWireSource",
                "SMPTEOutputDevice",
                "SMPTEOutputOffsetMS",
                "SMPTEInputDevice",
                "SMPTETimeCodeType",
                "SMPTETimeCodeProcessing",
                "SMPTEInputPlaylist",
                "SMPTEResendMultisync"
            ]
        }
    },
    "settings": {
        "SMPTETimeCodeEnabled": {
            "name": "SMPTETimeCodeEnabled",
            "description": "Enable TimeCodes",
            "tip": "Enable SMPTE TimeCode Support",
            "restart": 1,
            "reboot": 0,
            "type": "checkbox",
            "default": 0,
            "children": {
                "1": [
                    "SMPTETimeCodeType",
                    "SMPTEOutputPipeWireSource",
                    "SMPTEOutputDevice",
                    "SMPTEOutputOffsetMS",
                    "SMPTEInputDevice",
                    "SMPTETimeCodeProcessing",
                    "SMPTEInputPlaylist",
                    "SMPTEResendMultisync"
                ]
            }
        },
        "SMPTETimeCodeType": {
            "name": "SMPTETimeCodeType",
            "description": "SMPTE TimeCode Type",
            "tip": "The format of the TimeCode",
            "restart": 1,
            "reboot": 0,
            "default": 3,
            "type": "select",
            "options": {
                "30fps": 30,
                "29.97fps": 29.97,
                "25fps": 25,
                "24fps": 24
            }
        },
        "SMPTETimeCodeProcessing": {
            "name": "SMPTETimeCodeProcessing",
            "description": "Time Code Position Processing",
            "tip": "How timecodes and playlists are matched",
            "restart": 1,
            "reboot": 0,
            "default": 0,
            "type": "select",
            "options": {
                "Time within full playlist": 0,
                "Hour is index": 1,
                "1/4 hour is index": 2,
                "Time Codes within items": 3
            }
        },
        "SMPTEInputPlaylist": {
            "name": "SMPTEInputPlaylist",
            "description": "Playlist to sync the SMPTE TimeCode",
            "type": "select",
            "default": "",
            "restart": 1,
            "reboot": 0,
            "optionsURL": "api/playlists",
            "optionCanBeBlank": true,
            "fppModes": [
                "remote"
            ]
        },
        "SMPTEOutputPipeWireSource": {
            "name": "SMPTEOutputPipeWireSource",
            "description": "Output as PipeWire Source",
            "tip": "Publish the LTC timecode as a routable PipeWire source node ('SMPTE LTC Timecode') instead of sending it directly to an output device.  Route it to outputs, AES67, etc. via Input/Output Mixing.  Requires a PipeWire media backend; the Output Sound Device setting is ignored when enabled.",
            "restart": 1,
            "reboot": 0,
            "type": "checkbox",
            "default": 0,
            "fppModes": [
                "player"
            ]
        },
        "SMPTEOutputOffsetMS": {
            "name": "SMPTEOutputOffsetMS",
            "description": "Timecode Offset Trim (ms)",
            "tip": "Extra offset added to the outgoing timecode, in milliseconds.  Positive values send timecode early.  In PipeWire Source mode the graph/device latency is auto-detected and compensated already - use this only to trim for latency outside FPP (external gear, network audio receivers, etc.).",
            "restart": 1,
            "reboot": 0,
            "type": "number",
            "min": -5000,
            "max": 5000,
            "step": 1,
            "default": 0,
            "fppModes": [
                "player"
            ]
        },
        "SMPTEOutputDevice": {
            "name": "SMPTEOutputDevice",
            "description": "Output Sound Device",
            "tip": "The Audio Output Device to send the TimeCode",
            "restart": 1,
            "reboot": 0,
            "default": "",
            "type": "select",
            "optionsURL": "api/settings/AudioOutputList/options",
            "optionCanBeBlank": true,
            "fppModes": [
                "player"
            ]
        },
        "SMPTEInputDevice": {
            "name": "SMPTEInputDevice",
            "description": "Input Sound Device",
            "tip": "The Audio Input Device to receive the TimeCode",
            "restart": 1,
            "reboot": 0,
            "default": "",
            "type": "select",
            "optionsURL": "api/settings/AudioInputList/options",
            "optionCanBeBlank": true,
            "fppModes": [
                "remote"
            ]
        },
        "SMPTEResendMultisync": {
            "name": "SMPTEResendMultisync",
            "description": "Send FPP MultiSync Packets",
            "tip": "Send FPP MultiSync Packets",
            "restart": 1,
            "reboot": 0,
            "type": "checkbox",
            "default": 0,
            "fppModes": [
                "remote"
            ]
        }

    }
}